{
  "name": "quiz",
  "version": "1.0.0",
  "description": "Student assessments with server-side grading, MySQL and authenticated proctor tools",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test:submissions": "node --test tests/submissions.test.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "migrate": "node scripts/migrate.js",
    "db:init": "node scripts/init-db.js",
    "start:local": "node --env-file=.env server.js",
    "preflight": "node scripts/preflight.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "mysql2": "^3.22.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
